# Force LF regardless of the checking-out machine's core.autocrlf. Without this, a
# Windows clone with core.autocrlf=true checks shell scripts out with CRLF line
# endings, which get baked into Docker images verbatim and break at container start:
# `/usr/bin/env: 'bash\r': No such file or directory`.
* text=auto eol=lf
*.sh text eol=lf

# Genuine Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
